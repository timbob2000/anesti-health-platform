# Bind privileged values from the workspace environment's secret manager at runtime.
# Never commit .env or pass credentials as Docker build arguments.
PORT=3000
WORKSPACE_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
ONYX_BASE_URL=https://api.onyx.dev
ONYX_DATABASE_ID=REPLACE_WITH_ENVIRONMENT_DATABASE_ID
ONYX_API_KEY=REPLACE_WITH_SCOPED_SERVER_KEY
ONYX_API_SECRET=REPLACE_WITH_SCOPED_SERVER_SECRET
# Migration jobs may receive separate schema-manager credentials. The app must not.
ONYX_MIGRATION_API_KEY=REPLACE_WITH_SCHEMA_MANAGER_KEY
ONYX_MIGRATION_API_SECRET=REPLACE_WITH_SCHEMA_MANAGER_SECRET
# Required for migrations: durable shared POSIX directory common to ALL runners
# targeting this database. A private container filesystem is not sufficient.
MIGRATION_STATE_DIR=/var/lib/onyx-migrations
# Public Firebase configuration is served at runtime, allowing image promotion.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
FIREBASE_APP_ID=REPLACE_WITH_PUBLIC_WEB_APP_ID
FIREBASE_AUTH_PROVIDERS=password,google.com
# Preferred for isolated workspace containers: bind the complete service-account JSON
# as this encrypted server secret. Keep it empty until the secret binding is supplied.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Explicit alternative for a trusted workload identity or mounted secret file:
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Optional: deny otherwise valid users unless they have workspace_access=true.
REQUIRE_WORKSPACE_ACCESS_CLAIM=false
# Set to the admin origin to allow the isolated preview to be embedded there.
PREVIEW_PARENT_ORIGIN=http://localhost:3001
